import { Button, VerticalBox, HorizontalBox, Slider, LineEdit, ListView } from "std-widgets.slint";

export struct MediaRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
}

export component AppWindow inherits Window {
    title: "Vimivo — Every Sound. Every Frame.";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 840px;
    min-height: 540px;
    background: #0f1117;
    default-font-family: "Inter, system-ui, sans-serif";

    in-out property <string> search-text: "";
    in-out property <string> now-playing-title: "No Media Playing";
    in-out property <string> now-playing-artist: "Select a song or video to begin";
    in-out property <string> current-time: "00:00";
    in-out property <string> total-time: "00:00";
    in-out property <float> progress: 0.0;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-shuffled: false;
    in-out property <int> repeat-mode: 0; // 0: Off, 1: All, 2: One
    in-out property <[MediaRow]> media-list: [];
    in-out property <[float]> spectrum-bars: [0.1, 0.2, 0.4, 0.7, 0.9, 0.8, 0.6, 0.4, 0.3, 0.5, 0.7, 0.8, 0.6, 0.4, 0.2, 0.1];

    // DSP Properties
    in-out property <bool> show-dsp-panel: false;
    in-out property <float> bass-boost-db: 0.0;
    in-out property <float> virtualizer-width: 1.0;
    in-out property <bool> voice-clarity-enabled: false;

    // Vault Properties
    in-out property <bool> show-vault-dialog: false;
    in-out property <bool> vault-unlocked: false;
    in-out property <string> vault-pin-input: "";
    in-out property <string> vault-status-msg: "Enter 4-digit PIN to unlock private media";

    // Wi-Fi Transfer Properties
    in-out property <bool> wifi-server-active: false;
    in-out property <string> wifi-server-url: "";

    callback play-pause-clicked();
    callback next-clicked();
    callback previous-clicked();
    callback shuffle-toggled();
    callback repeat-toggled();
    callback item-selected(string);
    callback search-changed(string);
    callback progress-seeked(float);

    callback toggle-dsp-panel();
    callback bass-boost-changed(float);
    callback virtualizer-changed(float);
    callback voice-clarity-toggled();

    callback open-vault-dialog();
    callback submit-vault-pin(string);
    callback close-vault-dialog();

    callback toggle-wifi-server();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top App Bar / Header
        HorizontalBox {
            padding: 16px;
            spacing: 12px;
            height: 64px;

            Text {
                text: "Vimivo";
                font-size: 22px;
                font-weight: 800;
                color: #60a5fa;
                vertical-alignment: center;
            }

            Rectangle { width: 24px; }

            search-input := LineEdit {
                placeholder-text: "Search songs, artists, albums, or videos...";
                text <=> root.search-text;
                horizontal-stretch: 1;
                edited(text) => { root.search-changed(text); }
            }

            if root.wifi-server-active : Rectangle {
                background: #064e3b;
                border-radius: 6px;
                height: 36px;
                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Text { text: "🌐 " + root.wifi-server-url; font-size: 12px; font-weight: 600; color: #34d399; vertical-alignment: center; }
                }
            }
        }

        // Main Content Area: Sidebar + Media Table + Optional DSP Drawer
        HorizontalBox {
            padding: 0px;
            spacing: 0px;
            vertical-stretch: 1;

            // Sidebar
            Rectangle {
                width: 220px;
                background: #141722;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "LIBRARY";
                        font-size: 11px;
                        font-weight: 700;
                        color: #64748b;
                    }

                    Button { text: "🎵 Tracks"; }
                    Button { text: "🎬 Videos"; }
                    Button { text: "⭐ Favorites"; }

                    Rectangle { height: 12px; }

                    Text {
                        text: "SECURITY & SHARING";
                        font-size: 11px;
                        font-weight: 700;
                        color: #64748b;
                    }

                    Button {
                        text: root.vault-unlocked ? "🔓 Vault (Unlocked)" : "🔒 Private Vault";
                        clicked => { root.open-vault-dialog(); }
                    }

                    Button {
                        text: root.wifi-server-active ? "🛑 Stop Wi-Fi Share" : "🌐 Wi-Fi File Share";
                        clicked => { root.toggle-wifi-server(); }
                    }

                    Rectangle { height: 12px; }

                    Text {
                        text: "AUDIO DSP";
                        font-size: 11px;
                        font-weight: 700;
                        color: #64748b;
                    }

                    Button {
                        text: "🎛️ Equalizer & DSP";
                        clicked => { root.toggle-dsp-panel(); }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Button { text: "⚙️ Settings"; }
                }
            }

            // Divider
            Rectangle { width: 1px; background: #1e293b; }

            // Media List View
            Rectangle {
                background: #0f1117;
                horizontal-stretch: 1;

                VerticalBox {
                    padding: 16px;
                    spacing: 12px;

                    // Header row
                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        height: 32px;

                        Text { text: "TITLE"; font-size: 12px; font-weight: 600; color: #64748b; horizontal-stretch: 3; }
                        Text { text: "ARTIST"; font-size: 12px; font-weight: 600; color: #64748b; horizontal-stretch: 2; }
                        Text { text: "ALBUM"; font-size: 12px; font-weight: 600; color: #64748b; horizontal-stretch: 2; }
                        Text { text: "DURATION"; font-size: 12px; font-weight: 600; color: #64748b; width: 80px; }
                    }

                    Rectangle { height: 1px; background: #1e293b; }

                    ListView {
                        for item in root.media-list : Rectangle {
                            height: 48px;
                            background: touch.has-hover ? #1e293b : transparent;
                            border-radius: 6px;

                            touch := TouchArea {
                                clicked => { root.item-selected(item.id); }
                            }

                            HorizontalBox {
                                padding-left: 12px;
                                padding-right: 12px;

                                Text { text: item.title; color: #f8fafc; font-size: 14px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 3; }
                                Text { text: item.artist; color: #94a3b8; font-size: 13px; vertical-alignment: center; horizontal-stretch: 2; }
                                Text { text: item.album; color: #94a3b8; font-size: 13px; vertical-alignment: center; horizontal-stretch: 2; }
                                Text { text: item.duration; color: #64748b; font-size: 12px; vertical-alignment: center; width: 80px; }
                            }
                        }
                    }
                }
            }

            // DSP Side Panel (When visible)
            if root.show-dsp-panel : Rectangle {
                width: 280px;
                background: #141722;
                border-width: 1px;
                border-color: #1e293b;

                VerticalBox {
                    padding: 16px;
                    spacing: 16px;

                    HorizontalBox {
                        Text { text: "🎛️ Audio DSP Controls"; font-size: 14px; font-weight: 700; color: #60a5fa; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "✕"; clicked => { root.toggle-dsp-panel(); } }
                    }

                    Rectangle { height: 1px; background: #1e293b; }

                    // Bass Boost
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "Bass Boost: " + Math.round(root.bass-boost-db) + " dB"; font-size: 12px; font-weight: 600; color: #e2e8f0; }
                        Slider {
                            minimum: 0.0;
                            maximum: 18.0;
                            value <=> root.bass-boost-db;
                            changed(val) => { root.bass-boost-changed(val); }
                        }
                    }

                    // 3D Virtualizer
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "3D Spatial Width: " + Math.round(root.virtualizer-width * 100) + "%"; font-size: 12px; font-weight: 600; color: #e2e8f0; }
                        Slider {
                            minimum: 0.0;
                            maximum: 2.0;
                            value <=> root.virtualizer-width;
                            changed(val) => { root.virtualizer-changed(val); }
                        }
                    }

                    // Dialogue Clarity
                    HorizontalBox {
                        Text { text: "Dialogue / Voice Clarity"; font-size: 13px; font-weight: 600; color: #e2e8f0; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: root.voice-clarity-enabled ? "ON" : "OFF";
                            clicked => { root.voice-clarity-toggled(); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        // Bottom Playback Transport Bar + Spectrum Visualizer
        Rectangle {
            height: 104px;
            background: #141722;
            border-width: 1px;
            border-color: #1e293b;

            VerticalBox {
                padding: 10px;
                spacing: 6px;

                // Live Spectrum Visualizer HUD
                HorizontalBox {
                    alignment: center;
                    spacing: 4px;
                    height: 18px;

                    for val in root.spectrum-bars : Rectangle {
                        width: 8px;
                        height: Math.max(3px, val * 18px);
                        background: root.is-playing ? #38bdf8 : #334155;
                        border-radius: 2px;
                        y: 18px - self.height;
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 16px;

                    // Track Info Left
                    VerticalBox {
                        width: 240px;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.now-playing-title;
                            font-size: 14px;
                            font-weight: 600;
                            color: #f8fafc;
                            overflow: elide;
                        }

                        Text {
                            text: root.now-playing-artist;
                            font-size: 12px;
                            color: #94a3b8;
                            overflow: elide;
                        }
                    }

                    // Transport Controls Center
                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        alignment: center;

                        HorizontalBox {
                            alignment: center;
                            spacing: 16px;

                            Button {
                                text: root.is-shuffled ? "🔀 (On)" : "🔀";
                                clicked => { root.shuffle-toggled(); }
                            }
                            Button {
                                text: "⏮️";
                                clicked => { root.previous-clicked(); }
                            }
                            Button {
                                text: root.is-playing ? "⏸️ Pause" : "▶️ Play";
                                primary: true;
                                clicked => { root.play-pause-clicked(); }
                            }
                            Button {
                                text: "⏭️";
                                clicked => { root.next-clicked(); }
                            }
                            Button {
                                text: root.repeat-mode == 1 ? "🔁 All" : root.repeat-mode == 2 ? "🔂 One" : "🔁 Off";
                                clicked => { root.repeat-toggled(); }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            alignment: center;

                            Text { text: root.current-time; font-size: 11px; color: #64748b; vertical-alignment: center; }
                            Slider {
                                value <=> root.progress;
                                minimum: 0.0;
                                maximum: 100.0;
                                horizontal-stretch: 1;
                                changed(val) => { root.progress-seeked(val); }
                            }
                            Text { text: root.total-time; font-size: 11px; color: #64748b; vertical-alignment: center; }
                        }
                    }

                    // Volume Slider Right
                    HorizontalBox {
                        width: 180px;
                        spacing: 8px;
                        alignment: center;

                        Text { text: "🔊"; vertical-alignment: center; }
                        Slider {
                            value: 80.0;
                            minimum: 0.0;
                            maximum: 100.0;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // Vault Unlock Modal Dialog Overlay
    if root.show-vault-dialog : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        Rectangle {
            width: 380px;
            height: 240px;
            background: #1e293b;
            border-radius: 12px;
            border-width: 1px;
            border-color: #3b82f6;

            VerticalBox {
                padding: 24px;
                spacing: 12px;
                alignment: center;

                Text { text: "🔒 Private Video Vault"; font-size: 18px; font-weight: 700; color: #60a5fa; horizontal-alignment: center; }
                Text { text: root.vault-status-msg; font-size: 12px; color: #94a3b8; horizontal-alignment: center; }

                pin-input := LineEdit {
                    placeholder-text: "Enter PIN";
                    text <=> root.vault-pin-input;
                    accepted(text) => { root.submit-vault-pin(text); }
                }

                HorizontalBox {
                    spacing: 12px;
                    alignment: center;

                    Button {
                        text: "Cancel";
                        clicked => { root.close-vault-dialog(); }
                    }
                    Button {
                        text: "Unlock";
                        primary: true;
                        clicked => { root.submit-vault-pin(root.vault-pin-input); }
                    }
                }
            }
        }
    }
}