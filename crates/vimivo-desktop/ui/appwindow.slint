import { Button, VerticalBox, HorizontalBox, Slider, LineEdit, ListView } from "std-widgets.slint";

export struct MediaRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
}

export component AppWindow inherits Window {
    title: "Vimivo — Cinema-Grade Universal Media Player";
    preferred-width: 1120px;
    preferred-height: 740px;
    min-width: 880px;
    min-height: 560px;
    background: #08090d;
    default-font-family: "Inter, system-ui, -apple-system, sans-serif";

    in-out property <string> search-text: "";
    in-out property <string> now-playing-title: "No Media Playing";
    in-out property <string> now-playing-artist: "Select a track or video to begin playback";
    in-out property <string> current-time: "00:00";
    in-out property <string> total-time: "00:00";
    in-out property <float> progress: 0.0;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-shuffled: false;
    in-out property <int> repeat-mode: 0; // 0: Off, 1: All, 2: One
    in-out property <[MediaRow]> media-list: [];
    in-out property <[float]> spectrum-bars: [0.15, 0.28, 0.45, 0.72, 0.94, 0.82, 0.65, 0.48, 0.35, 0.52, 0.74, 0.88, 0.62, 0.44, 0.25, 0.12];

    // Hardware Decoder Switcher
    in-out property <string> decoder-mode: "HW+"; // "HW+", "HW", "SW"

    // Volume & Soft-Knee Limiter Boost (0 - 200%)
    in-out property <float> volume: 100.0;

    // DSP Properties
    in-out property <bool> show-dsp-panel: false;
    in-out property <float> bass-boost-db: 0.0;
    in-out property <float> virtualizer-width: 1.0;
    in-out property <bool> voice-clarity-enabled: false;

    // Vault Properties
    in-out property <bool> show-vault-dialog: false;
    in-out property <bool> vault-unlocked: false;
    in-out property <string> vault-pin-input: "";
    in-out property <string> vault-status-msg: "Enter 4-digit PIN to unlock private media";

    // Wi-Fi Transfer Properties
    in-out property <bool> wifi-server-active: false;
    in-out property <string> wifi-server-url: "";

    // A-B Loop Repeat
    in-out property <string> ab-loop-label: "A-B Loop";
    in-out property <bool> ab-loop-active: false;

    // Stats for Nerds / Diagnostics Modal
    in-out property <bool> show-stats-dialog: false;
    in-out property <string> stats-video: "3840x2160 (4K UHD) · HEVC Main 10";
    in-out property <string> stats-audio: "FLAC 24-bit · 5.1 Surround 48.0 kHz";
    in-out property <string> stats-decoder: "⚡ Hardware (HW+)";
    in-out property <string> stats-bitrate: "18.4 Mbps";
    in-out property <string> stats-dropped: "0 / 14200 (0.00%)";
    in-out property <string> stats-buffer: "5.2 s";

    callback play-pause-clicked();
    callback next-clicked();
    callback previous-clicked();
    callback shuffle-toggled();
    callback repeat-toggled();
    callback ab-loop-clicked();
    callback toggle-stats-dialog();
    callback item-selected(string);
    callback search-changed(string);
    callback progress-seeked(float);
    callback volume-changed(float);
    callback decoder-mode-toggled();

    callback toggle-dsp-panel();
    callback bass-boost-changed(float);
    callback virtualizer-changed(float);
    callback voice-clarity-toggled();

    callback open-vault-dialog();
    callback submit-vault-pin(string);
    callback close-vault-dialog();

    callback toggle-wifi-server();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top App Bar / Header
        Rectangle {
            height: 64px;
            background: #0f1118;
            border-width: 1px;
            border-color: #1a1d2c;

            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                alignment: center;

                // Brand Logo & Title
                HorizontalBox {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: #0284c7;

                        Text {
                            text: "V";
                            font-size: 16px;
                            font-weight: 900;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "VIMIVO";
                        font-size: 18px;
                        font-weight: 800;
                        color: #38bdf8;
                        vertical-alignment: center;
                    }
                }

                Rectangle { width: 12px; }

                // Search Bar
                search-input := LineEdit {
                    placeholder-text: "Search tracks, videos, artists, albums, or network sources...";
                    text <=> root.search-text;
                    horizontal-stretch: 1;
                    edited(text) => { root.search-changed(text); }
                }

                // Wi-Fi File Sharing Status Pill
                if root.wifi-server-active : Rectangle {
                    background: #064e3b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #059669;
                    height: 34px;

                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: "Wi-Fi: " + root.wifi-server-url;
                            font-size: 12px;
                            font-weight: 600;
                            color: #34d399;
                            vertical-alignment: center;
                        }
                    }
                }

                // Vault Status Pill
                Rectangle {
                    background: root.vault-unlocked ? #064e3b : #1e293b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.vault-unlocked ? #059669 : #334155;
                    height: 34px;

                    TouchArea {
                        clicked => { root.open-vault-dialog(); }
                    }

                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: root.vault-unlocked ? "Vault Unlocked" : "Private Vault";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.vault-unlocked ? #34d399 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Main Content Area: Sidebar + Media Table + Optional DSP Drawer
        HorizontalBox {
            padding: 0px;
            spacing: 0px;
            vertical-stretch: 1;

            // Sidebar
            Rectangle {
                width: 220px;
                background: #0d0f17;
                border-width: 1px;
                border-color: #1a1d2c;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "LIBRARY";
                        font-size: 11px;
                        font-weight: 700;
                        color: #64748b;
                    }

                    Button { text: "Tracks & Songs"; }
                    Button { text: "Video Library"; }
                    Button { text: "Favorites"; }

                    Rectangle { height: 12px; }

                    Text {
                        text: "FEATURES & TOOLS";
                        font-size: 11px;
                        font-weight: 700;
                        color: #64748b;
                    }

                    Button {
                        text: root.vault-unlocked ? "Vault (Unlocked)" : "Private Vault";
                        clicked => { root.open-vault-dialog(); }
                    }

                    Button {
                        text: root.wifi-server-active ? "Stop Wi-Fi Share" : "Wi-Fi File Sharing";
                        clicked => { root.toggle-wifi-server(); }
                    }

                    Button {
                        text: "Stats for Nerds";
                        clicked => { root.toggle-stats-dialog(); }
                    }

                    Rectangle { height: 12px; }

                    Text {
                        text: "AUDIO & DSP";
                        font-size: 11px;
                        font-weight: 700;
                        color: #64748b;
                    }

                    Button {
                        text: root.show-dsp-panel ? "Close DSP Panel" : "Equalizer & DSP";
                        clicked => { root.toggle-dsp-panel(); }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "Zero ads · Zero telemetry";
                        font-size: 10px;
                        color: #475569;
                        horizontal-alignment: center;
                    }
                }
            }

            // Media List View
            Rectangle {
                background: #08090d;
                horizontal-stretch: 1;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    // Header row
                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        height: 28px;

                        Text { text: "TITLE"; font-size: 11px; font-weight: 700; color: #64748b; horizontal-stretch: 4; }
                        Text { text: "ARTIST"; font-size: 11px; font-weight: 700; color: #64748b; horizontal-stretch: 3; }
                        Text { text: "ALBUM"; font-size: 11px; font-weight: 700; color: #64748b; horizontal-stretch: 3; }
                        Text { text: "DURATION"; font-size: 11px; font-weight: 700; color: #64748b; width: 70px; horizontal-alignment: right; }
                    }

                    Rectangle { height: 1px; background: #1a1d2c; }

                    ListView {
                        for item in root.media-list : Rectangle {
                            height: 44px;
                            background: row-touch.has-hover ? #151824 : transparent;
                            border-radius: 6px;

                            row-touch := TouchArea {
                                clicked => { root.item-selected(item.id); }
                            }

                            HorizontalBox {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: center;

                                Text {
                                    text: item.title;
                                    color: #f8fafc;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    horizontal-stretch: 4;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.artist;
                                    color: #94a3b8;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 3;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.album;
                                    color: #64748b;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 3;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.duration;
                                    color: #94a3b8;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 70px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }

            // DSP Side Drawer
            if root.show-dsp-panel : Rectangle {
                width: 290px;
                background: #0f1118;
                border-width: 1px;
                border-color: #1a1d2c;

                VerticalBox {
                    padding: 18px;
                    spacing: 16px;

                    HorizontalBox {
                        Text {
                            text: "Audio DSP Controls";
                            font-size: 15px;
                            font-weight: 700;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "✕";
                            clicked => { root.toggle-dsp-panel(); }
                        }
                    }

                    Rectangle { height: 1px; background: #1e293b; }

                    // Bass Boost
                    VerticalBox {
                        spacing: 6px;
                        HorizontalBox {
                            Text { text: "Bass Boost"; font-size: 12px; font-weight: 600; color: #f1f5f9; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: Math.round(root.bass-boost-db) + " dB"; font-size: 12px; font-weight: 700; color: #38bdf8; }
                        }
                        Slider {
                            minimum: 0.0;
                            maximum: 18.0;
                            value <=> root.bass-boost-db;
                            changed(val) => { root.bass-boost-changed(val); }
                        }
                    }

                    // 3D Virtualizer
                    VerticalBox {
                        spacing: 6px;
                        HorizontalBox {
                            Text { text: "3D Spatial Width"; font-size: 12px; font-weight: 600; color: #f1f5f9; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: Math.round(root.virtualizer-width * 100) + "%"; font-size: 12px; font-weight: 700; color: #818cf8; }
                        }
                        Slider {
                            minimum: 0.0;
                            maximum: 2.0;
                            value <=> root.virtualizer-width;
                            changed(val) => { root.virtualizer-changed(val); }
                        }
                    }

                    // Dialogue Voice Clarity
                    HorizontalBox {
                        alignment: center;
                        Text { text: "Dialogue / Voice Clarity"; font-size: 13px; font-weight: 600; color: #f1f5f9; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: root.voice-clarity-enabled ? "ACTIVE" : "OFF";
                            clicked => { root.voice-clarity-toggled(); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "Processed via Pure Rust DSP";
                        font-size: 11px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Bottom Cinema Playback Transport Bar
        Rectangle {
            height: 108px;
            background: #0c0e15;
            border-width: 1px;
            border-color: #1a1d2c;

            VerticalBox {
                padding: 10px;
                spacing: 6px;

                // Live Glowing 16-Band Spectrum Visualizer HUD
                HorizontalBox {
                    alignment: center;
                    spacing: 4px;
                    height: 16px;

                    for val in root.spectrum-bars : Rectangle {
                        width: 7px;
                        height: Math.max(2px, val * 16px);
                        background: root.is-playing ? #38bdf8 : #1e293b;
                        border-radius: 2px;
                        y: 16px - self.height;
                    }
                }

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 16px;
                    alignment: center;

                    // Track Info Left
                    HorizontalBox {
                        width: 250px;
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 6px;
                            background: #1e293b;
                            border-width: 1px;
                            border-color: #334155;

                            Text {
                                text: root.is-playing ? "▶" : "■";
                                font-size: 16px;
                                color: root.is-playing ? #38bdf8 : #64748b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalBox {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: root.now-playing-title;
                                font-size: 13px;
                                font-weight: 600;
                                color: #f8fafc;
                                overflow: elide;
                            }

                            Text {
                                text: root.now-playing-artist;
                                font-size: 11px;
                                color: #94a3b8;
                                overflow: elide;
                            }
                        }
                    }

                    // Transport Controls & Timeline Center
                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        alignment: center;

                        HorizontalBox {
                            alignment: center;
                            spacing: 12px;

                            Button {
                                text: root.is-shuffled ? "⇄ (On)" : "⇄";
                                clicked => { root.shuffle-toggled(); }
                            }
                            Button {
                                text: "⏮";
                                clicked => { root.previous-clicked(); }
                            }
                            Button {
                                text: root.is-playing ? "⏸ Pause" : "⏵ Play";
                                primary: true;
                                clicked => { root.play-pause-clicked(); }
                            }
                            Button {
                                text: "⏭";
                                clicked => { root.next-clicked(); }
                            }
                            Button {
                                text: root.repeat-mode == 1 ? "↻ All" : root.repeat-mode == 2 ? "↻ 1" : "↻ Off";
                                clicked => { root.repeat-toggled(); }
                            }
                            Button {
                                text: root.ab-loop-label;
                                primary: root.ab-loop-active;
                                clicked => { root.ab-loop-clicked(); }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            alignment: center;

                            Text { text: root.current-time; font-size: 11px; font-weight: 600; color: #64748b; vertical-alignment: center; }
                            Slider {
                                value <=> root.progress;
                                minimum: 0.0;
                                maximum: 100.0;
                                horizontal-stretch: 1;
                                changed(val) => { root.progress-seeked(val); }
                            }
                            Text { text: root.total-time; font-size: 11px; font-weight: 600; color: #64748b; vertical-alignment: center; }
                        }
                    }

                    // Right Side: Hardware Decoder Chip & Volume (up to 200%)
                    HorizontalBox {
                        width: 260px;
                        spacing: 12px;
                        alignment: center;

                        // Hardware Decoder Mode Switcher Chip
                        Rectangle {
                            background: root.decoder-mode == "HW+" ? #064e3b : root.decoder-mode == "HW" ? #0c4a6e : #1e293b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.decoder-mode == "HW+" ? #059669 : root.decoder-mode == "HW" ? #0284c7 : #475569;
                            height: 30px;

                            TouchArea {
                                clicked => { root.decoder-mode-toggled(); }
                            }

                            HorizontalBox {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;

                                Text {
                                    text: root.decoder-mode == "HW+" ? "⚡ HW+" : root.decoder-mode == "HW" ? "⚡ HW" : "💻 SW";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.decoder-mode == "HW+" ? #34d399 : root.decoder-mode == "HW" ? #38bdf8 : #94a3b8;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Volume Control with Soft-Knee Limiter Boost Badge (>100%)
                        HorizontalBox {
                            spacing: 6px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: root.volume > 100.0 ? "⚡" : "🔊";
                                font-size: 12px;
                                color: root.volume > 100.0 ? #f59e0b : #94a3b8;
                                vertical-alignment: center;
                            }

                            Slider {
                                value <=> root.volume;
                                minimum: 0.0;
                                maximum: 200.0;
                                horizontal-stretch: 1;
                                changed(val) => { root.volume-changed(val); }
                            }

                            Text {
                                text: root.volume > 100.0 ? Math.round(root.volume) + "% BOOST" : Math.round(root.volume) + "%";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.volume > 100.0 ? #f59e0b : #64748b;
                                vertical-alignment: center;
                                width: 55px;
                            }
                        }
                    }
                }
            }
        }
    }

    // Vault PIN Dialog Overlay
    if root.show-vault-dialog : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000dd;

        Rectangle {
            width: 400px;
            height: 250px;
            background: #151824;
            border-radius: 12px;
            border-width: 1px;
            border-color: #38bdf8;

            VerticalBox {
                padding: 24px;
                spacing: 12px;
                alignment: center;

                Text { text: "Private Video Vault"; font-size: 18px; font-weight: 700; color: #38bdf8; horizontal-alignment: center; }
                Text { text: root.vault-status-msg; font-size: 12px; color: #94a3b8; horizontal-alignment: center; }

                pin-input := LineEdit {
                    placeholder-text: "Enter 4-digit PIN";
                    text <=> root.vault-pin-input;
                    accepted(text) => { root.submit-vault-pin(text); }
                }

                HorizontalBox {
                    spacing: 12px;
                    alignment: center;

                    Button {
                        text: "Cancel";
                        clicked => { root.close-vault-dialog(); }
                    }
                    Button {
                        text: "Unlock Vault";
                        primary: true;
                        clicked => { root.submit-vault-pin(root.vault-pin-input); }
                    }
                }
            }
        }
    }

    // Stats for Nerds Diagnostics Dialog Overlay
    if root.show-stats-dialog : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000dd;

        Rectangle {
            width: 480px;
            height: 360px;
            background: #10121a;
            border-radius: 12px;
            border-width: 1px;
            border-color: #38bdf8;

            VerticalBox {
                padding: 24px;
                spacing: 12px;

                HorizontalBox {
                    Text { text: "Playback Diagnostics (Stats for Nerds)"; font-size: 15px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "✕"; clicked => { root.toggle-stats-dialog(); } }
                }

                Rectangle { height: 1px; background: #1e293b; }

                HorizontalBox {
                    Text { text: "Video Stream:"; font-size: 12px; font-weight: 600; color: #94a3b8; width: 110px; }
                    Text { text: root.stats-video; font-size: 12px; font-weight: 600; color: #f8fafc; }
                }
                HorizontalBox {
                    Text { text: "Audio Stream:"; font-size: 12px; font-weight: 600; color: #94a3b8; width: 110px; }
                    Text { text: root.stats-audio; font-size: 12px; font-weight: 600; color: #f8fafc; }
                }
                HorizontalBox {
                    Text { text: "Active Decoder:"; font-size: 12px; font-weight: 600; color: #94a3b8; width: 110px; }
                    Text { text: root.stats-decoder; font-size: 12px; font-weight: 700; color: #34d399; }
                }
                HorizontalBox {
                    Text { text: "Live Bitrate:"; font-size: 12px; font-weight: 600; color: #94a3b8; width: 110px; }
                    Text { text: root.stats-bitrate; font-size: 12px; font-weight: 600; color: #f8fafc; }
                }
                HorizontalBox {
                    Text { text: "Dropped Frames:"; font-size: 12px; font-weight: 600; color: #94a3b8; width: 110px; }
                    Text { text: root.stats-dropped; font-size: 12px; font-weight: 600; color: #f8fafc; }
                }
                HorizontalBox {
                    Text { text: "Buffer Health:"; font-size: 12px; font-weight: 600; color: #94a3b8; width: 110px; }
                    Text { text: root.stats-buffer; font-size: 12px; font-weight: 600; color: #38bdf8; }
                }

                Rectangle { vertical-stretch: 1; }

                Button {
                    text: "Close Diagnostics";
                    primary: true;
                    clicked => { root.toggle-stats-dialog(); }
                }
            }
        }
    }
}
