{
  "app-id": "dev.vimivo.desktop",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "vimivo",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--share=network",
    "--filesystem=xdg-music:ro",
    "--filesystem=xdg-videos:ro",
    "--filesystem=xdg-download:ro",
    "--talk-name=org.mpris.MediaPlayer2.vimivo",
    "--talk-name=org.freedesktop.secrets"
  ],
  "modules": [
    {
      "name": "vimivo",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/bin /app/lib",
        "cp -r * /app/lib/",
        "ln -s /app/lib/bin/Vimivo /app/bin/vimivo",
        "install -Dm644 dev.vimivo.desktop.desktop /app/share/applications/dev.vimivo.desktop.desktop",
        "install -Dm644 dev.vimivo.desktop.metainfo.xml /app/share/metainfo/dev.vimivo.desktop.metainfo.xml",
        "install -Dm644 icon.png /app/share/icons/hicolor/512x512/apps/dev.vimivo.desktop.png"
      ]
    }
  ]
}
